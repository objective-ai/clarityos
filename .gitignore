# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
tests/e2e/.auth-session.json
.eslintcache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc
*.bak

# temporary files
tmp/
tmp-*.png
tmp-*.js
test-data.mjs
test-login.mjs

# MCP config (may contain API keys)
.mcp.json

# screenshots / local test artifacts
prod-*.png
vercel-*.png
.playwright-cli/
test-results/

# claude code
.claude/

# local docs / specs (not for repo)
docs/

# test artifacts
finalized-enc.yaml
